# Same Gemini API key you used in n8n / Google AI Studio.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Recommended model for Gemini API:
GEMINI_MODEL=gemini-3.8-flash

# Google Sheets ID, copied from https://docs.google.com/spreadsheets/d/YOUR_ID/edit
GOOGLE_SHEET_ID=1iqyn7fKG-Lpmq5IXcNBTfu1navv8eg6fK_T3v0xetnE
GOOGLE_SHEET_TAB=Jobs
# Relative to this folder; do not commit or share this file.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Local SQLite Database file for instant deduplication (zero Postgres needed)
SQLITE_DB_PATH=./jobs.db

# Free-tier Gemini rate limit is 5 RPM. 13000ms delay ensures zero 429 quota errors.
MAX_NEW_JOBS=10
LLM_DELAY_MS=13000
# Filter jobs clearly located outside India. Unspecified/remote roles still need manual review.
INDIA_ONLY=true
