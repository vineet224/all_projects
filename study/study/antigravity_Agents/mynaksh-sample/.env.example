PORT=3000
NODE_ENV=development

# Upstream service resilience timeouts (milliseconds)
UPSTREAM_TIMEOUT_MS=800

# In-memory Cache TTLs (milliseconds)
CACHE_USER_TTL_MS=3600000
CACHE_PANCHANG_TTL_MS=21600000

# LLM Configuration
# Set your Gemini API key to use real LLM; leave blank to use the astrologically grounded Mock LLM
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=mock

