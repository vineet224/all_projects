      "boundElements": [],
      "updated": 1777519694378,
      "link": null,
      "locked": false,
      "text": "We could add the cache here\nas well if the write for the\navailability updation is\nhappening at our service only\nlike there could be more our\nsuch parties that are using\nthe same vendor so we have\nto query they vendor must\nthen only we know the\navailability else we don't know\nor if we consider that our\nservice is only updating then\nwe can add the cache here\nbecause updates are less and\nreads are high",
      "fontSize": 20,
      "fontFamily": 5,
