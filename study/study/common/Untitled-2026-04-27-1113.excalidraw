    {
      "id": "NZtyfS9phJDPOkkX7y02j",
      "type": "text",
      "x": 1430.214340765187,
      "y": -188.5541331283912,
      "width": 801.695556640625,
      "height": 168.0254348701895,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "CfdGdwReBeyN037JXiqxX",
      "index": "b1U",
      "roundness": null,
      "seed": 987784819,
      "version": 1002,
      "versionNonce": 1524749931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777473499349,
      "link": null,
      "locked": false,
      "text": "So for this we can have different queues for different events like we have \nan events of like tommorow , or today so there is high ticket booking, \nand if also like if the event is of big celebrity then it will have high request\nwhen the window is open so for those i could have a whole seperate queue\nand for other events where the traffic is not much high i can have a few queue only\nalso how i would dynamically add the queues based on the events is there is a way or\nthis whole theory is bullshit",
      "fontSize": 19.202906842307375,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So for this we can have different queues for different events like we have \nan events of like tommorow , or today so there is high ticket booking, \nand if also like if the event is of big celebrity then it will have high request\nwhen the window is open so for those i could have a whole seperate queue\nand for other events where the traffic is not much high i can have a few queue only\nalso how i would dynamically add the queues based on the events is there is a way or\nthis whole theory is bullshit",
      "autoResize": true,
      "lineHeight": 1.25
    },
