      "updated": 1777473499349,
      "link": null,
      "locked": false,
      "text": "We could add the cache here\nas well if the write for the\navailability updation is\nhappening at our service only\nlike there could be more our\nsuch parties that are using\nthe same vendor so we have\nto query they vendor must\nthen only we know the\navailability else we don't know\nor if we consider that our\nservice is only updating then\nwe can add the cache here\nbecause updates are less and\nreads are high",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "tWgEcv2MDygVNlbvXMp43",
      "originalText": "We could add the cache here as well if the write for the availability updation is happening at our service only like there could be more our such parties that are using the same vendor so we have to query they vendor must then only we know the availability else we don't know or if we consider that our service is only updating then we can add the cache here because updates are less and reads are high",
      "autoResize": true,
      "lineHeight": 1.25
    },
